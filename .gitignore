# Artefactos binarios generados por ETL
*.zip

# Artefactos intermedios del ETL (se regeneran en cada build, no se commitean)
# IM-025: evita el ruido en Git (el bot hacia commit del borrado en cada build)
zoho-survey/students/**/intermediate/
zoho-survey/students/**/exports/
zoho-survey/alumni/**/intermediate/
zoho-survey/alumni/**/exports/
zoho-survey/employers/**/intermediate/
zoho-survey/employers/**/exports/
zoho-survey/facultystaff/**/intermediate/
zoho-survey/facultystaff/**/exports/
zoho-survey/nonfacultystaff/**/intermediate/
zoho-survey/nonfacultystaff/**/exports/

# Huella de idempotencia del ETL (versionada: <HASH_VERSION>:<sha256 del CSV>)
.csv_hash

# Datos fuente: los CSVs NUNCA se commitean (contienen comentarios NPS con PII
# potencial) y este repositorio es público.
# POLITICA DE INGESTA (v3.2.0+): los CSVs entran SOLO por el portal ("Subir
# datos" -> Release DRAFT temporal -> repository_dispatch) o por un Release con
# tag + workflow_dispatch; Actions los descarga a data/, los sanitiza, ejecuta el
# ETL y los borra antes del commit del bot. La sanitización en CI es defensa en
# profundidad, no control primario.
data/

# Environment files (secrets never committed)
.env
.env.*
!.env.example
# la sanitizacion en CI es defensa en profundidad, no control primario.

# Misc
Mejoras/
*.log
*.tmp
*.bak
*.orig
node_modules/
testsprite_tests/tmp/config.json