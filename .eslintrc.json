{
  "env": {
    "browser": true,
    "es2021": true
  },
  "globals": {
    "window": "readonly",
    "document": "readonly"
  },
  "rules": {
    "no-unused-vars": ["warn", { "args": "none" }],
    "no-undef": "error",
    "no-alert": "warn",
    "no-implied-eval": "error",
    "no-var": "warn"
  },
  "ignorePatterns": ["node_modules/", "*.min.js"]
}
