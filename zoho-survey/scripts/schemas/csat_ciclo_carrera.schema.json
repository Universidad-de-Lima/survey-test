{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-storytelling/schemas/csat_ciclo_carrera.json",
  "title": "CSAT por Ciclo y Carrera",
  "description": "Distribución CSAT agregada por facultad/carrera/ciclo. Claves en formato Zoho Survey (capitalizado). Fuente de verdad: build_json.py.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "facultad", "carrera", "ciclo",
      "Totalmente satisfecho", "Muy satisfecho", "Satisfecho",
      "Insatisfecho", "Totalmente insatisfecho"
    ],
    "additionalProperties": false,
    "properties": {
      "facultad": { "type": "string", "minLength": 1 },
      "carrera": { "type": "string", "minLength": 1 },
      "ciclo": { "type": "string" },
      "Totalmente satisfecho": { "type": "integer", "minimum": 0 },
      "Muy satisfecho": { "type": "integer", "minimum": 0 },
      "Satisfecho": { "type": "integer", "minimum": 0 },
      "Insatisfecho": { "type": "integer", "minimum": 0 },
      "Totalmente insatisfecho": { "type": "integer", "minimum": 0 },
      "No utilizo": { "type": "integer", "minimum": 0 },
      "No conozco": { "type": "integer", "minimum": 0 },
      "score": { "type": "number", "minimum": 0, "maximum": 100, "description": "Score CSAT calculado como t3b/total * 100." }
    }
  }
}
