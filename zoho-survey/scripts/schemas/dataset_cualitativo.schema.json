{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-storytelling/dataset_cualitativo.schema.json",
  "title": "Dataset Cualitativo (intermedio ETL)",
  "description": "Schema para dataset_cualitativo.json. Archivo intermedio producido por el motor IA (DeepSeek) y consumido por validar_ia_vs_manual.py. No es consumido por el frontend.",
  "type": "object",
  "required": ["metadata", "data"],
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["total_encuestas", "total_fragmentos", "errores", "ruido_filtrado", "cache_hits", "tiempo_segundos", "stats_sentimiento", "usage"],
      "additionalProperties": false,
      "properties": {
        "total_encuestas": { "type": "integer", "minimum": 0 },
        "total_fragmentos": { "type": "integer", "minimum": 0 },
        "errores": { "type": "integer", "minimum": 0 },
        "ruido_filtrado": { "type": "integer", "minimum": 0 },
        "fallos_api": { "type": "integer", "minimum": 0 },
        "intentos_api": { "type": "integer", "minimum": 0 },
        "tasa_fallos_api": { "type": "number", "minimum": 0, "maximum": 100 },
        "cache_hits": { "type": "integer", "minimum": 0 },
        "tiempo_segundos": { "type": "number", "minimum": 0 },
        "stats_sentimiento": {
          "type": "object",
          "required": ["total_opinion_units", "positivos", "negativos", "neutros"],
          "additionalProperties": false,
          "properties": {
            "total_opinion_units": { "type": "integer", "minimum": 0 },
            "positivos": { "type": "integer", "minimum": 0 },
            "negativos": { "type": "integer", "minimum": 0 },
            "neutros": { "type": "integer", "minimum": 0 }
          }
        },
        "usage": {
          "type": "object",
          "required": ["input_tokens", "output_tokens", "total_tokens"],
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id_encuesta", "id_fragmento", "facultad", "carrera", "ciclo", "nps_score", "segmento_nps", "satisfaccion_global", "texto", "aspecto_detectado", "aspecto_normalizado", "categoria_padre", "sub_aspectos", "sentimiento", "intensidad", "confianza_sentimiento", "comentario_original", "es_valido", "motivo_invalidez", "motor"],
        "additionalProperties": true,
        "properties": {
          "id_encuesta": { "type": "string" },
          "id_fragmento": { "type": "string" },
          "facultad": { "type": "string" },
          "carrera": { "type": "string" },
          "ciclo": { "type": "string" },
          "nps_score": { "type": "integer", "minimum": 0, "maximum": 10 },
          "segmento_nps": { "type": "string", "enum": ["Promotor", "Pasivo", "Detractor"] },
          "satisfaccion_global": { "type": "string" },
          "texto": { "type": "string" },
          "aspecto_detectado": { "type": "string" },
          "aspecto_normalizado": { "type": "string" },
          "categoria_padre": { "type": "string" },
          "sub_aspectos": { "type": "array", "items": { "type": "string" } },
          "sentimiento": { "type": "string", "enum": ["positivo", "negativo", "neutro"] },
          "intensidad": { "type": "integer", "minimum": 1, "maximum": 5 },
          "confianza_sentimiento": { "type": "number", "minimum": 0, "maximum": 1 },
          "comentario_original": { "type": "string" },
          "es_valido": { "type": "boolean" },
          "motivo_invalidez": { "type": ["string", "null"] },
          "motor": { "type": "string", "enum": ["deepseek", "nvidia"] }
        }
      }
    }
  }
}
