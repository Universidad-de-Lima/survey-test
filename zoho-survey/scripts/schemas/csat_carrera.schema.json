{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-test/scripts/schemas/csat_carrera.schema.json",
  "title": "CSAT por Carrera",
  "description": "Conteos de la escala de satisfaccion agregados por carrera, mas el score (top-3-box). Parte 'csat_carrera' de resumenes.json. Fuente de verdad: build_json.py.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "carrera",
      "facultad",
      "Totalmente satisfecho",
      "Muy satisfecho",
      "Satisfecho",
      "Insatisfecho",
      "Totalmente insatisfecho"
    ],
    "additionalProperties": false,
    "properties": {
      "carrera": {
        "type": "string",
        "minLength": 1
      },
      "facultad": {
        "type": "string",
        "minLength": 1
      },
      "Totalmente satisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Muy satisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Satisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Insatisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Totalmente insatisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "No utilizo": {
        "type": "integer",
        "minimum": 0
      },
      "No conozco": {
        "type": "integer",
        "minimum": 0
      },
      "score": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  }
}
