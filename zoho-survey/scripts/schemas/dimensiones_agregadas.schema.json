{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-test/scripts/schemas/dimensiones_agregadas.schema.json",
  "title": "Dimensiones agregadas",
  "description": "Totales por dimension sumando todas las facultades, carreras y ciclos, con los tres recuentos que dibujan el radar y las tablas (top-3, top-2 y promedio ponderado) y los porcentajes de la barra de visibilidad. Parte 'dimensiones' de resumenes.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "categoria",
      "dimension",
      "Totalmente satisfecho",
      "Muy satisfecho",
      "Satisfecho",
      "Insatisfecho",
      "Totalmente insatisfecho",
      "no_utilizo",
      "no_conozco",
      "total",
      "encuestas",
      "t3b_pct",
      "top2box_pct",
      "ponderado_pct"
    ],
    "additionalProperties": false,
    "properties": {
      "categoria": {
        "type": "string",
        "minLength": 1
      },
      "dimension": {
        "type": "string",
        "minLength": 1
      },
      "Totalmente satisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Muy satisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Satisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Insatisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "Totalmente insatisfecho": {
        "type": "integer",
        "minimum": 0
      },
      "no_utilizo": {
        "type": "integer",
        "minimum": 0
      },
      "no_conozco": {
        "type": "integer",
        "minimum": 0
      },
      "total": {
        "type": "integer",
        "minimum": 0
      },
      "encuestas": {
        "type": "integer",
        "minimum": 0
      },
      "t3b_pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "top2box_pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "ponderado_pct": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "pct_no_conozco": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "pct_no_utilizo": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "pct_conoce": {
        "type": "number",
        "minimum": 0,
        "maximum": 100
      }
    }
  }
}
