{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-storytelling/schemas/filtros.json",
  "title": "Filtros",
  "description": "Metadatos de filtros para la cascada Facultad → Carrera → Ciclo.",
  "type": "object",
  "required": ["version", "has_ciclo", "facultades", "carreras", "ciclos", "facultad_carrera"],
  "properties": {
    "version": {
      "type": "string",
      "const": "2.0"
    },
    "has_ciclo": {
      "type": "boolean",
      "description": "true si la encuesta tiene columna Ciclo (pregrado), false en caso contrario"
    },
    "facultades": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "carreras": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "ciclos": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "facultad_carrera": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    }
  }
}
