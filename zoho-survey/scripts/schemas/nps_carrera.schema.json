{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-test/scripts/schemas/nps_carrera.schema.json",
  "title": "NPS por Carrera",
  "description": "Distribucion NPS agregada por carrera. Claves en minusculas (canonicas). Fuente de verdad: build_json.py. Parte 'nps_carrera' de resumenes.json.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "carrera",
      "promotores",
      "pasivos",
      "detractores"
    ],
    "additionalProperties": false,
    "properties": {
      "carrera": {
        "type": "string",
        "minLength": 1
      },
      "promotores": {
        "type": "integer",
        "minimum": 0
      },
      "pasivos": {
        "type": "integer",
        "minimum": 0
      },
      "detractores": {
        "type": "integer",
        "minimum": 0
      },
      "score": {
        "type": "number",
        "minimum": -100,
        "maximum": 100
      }
    }
  }
}
