{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://universidad-de-lima.github.io/survey-storytelling/schemas/dimensiones.json",
  "title": "Dimensiones",
  "description": "Agregados por facultad/carrera/ciclo/categoría/dimensión. Fuente de verdad: build_json.py. Versión implícita del contrato.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": [
      "facultad", "carrera", "ciclo", "categoria", "dimension",
      "t3b", "b2b", "total", "t3b_pct", "no_utilizo", "no_conozco",
      "Totalmente satisfecho", "Muy satisfecho", "Satisfecho",
      "Insatisfecho", "Totalmente insatisfecho",
      "No utilizo", "No conozco"
    ],
    "additionalProperties": false,
    "properties": {
      "facultad": { "type": "string", "minLength": 1 },
      "carrera": { "type": "string", "minLength": 1 },
      "ciclo": { "type": "string" },
      "categoria": { "type": "string", "minLength": 1 },
      "dimension": { "type": "string", "minLength": 1 },
      "t3b": { "type": "integer", "minimum": 0 },
      "b2b": { "type": "integer", "minimum": 0 },
      "total": { "type": "integer", "minimum": 0 },
      "t3b_pct": { "type": "number", "minimum": 0, "maximum": 100 },
      "no_utilizo": { "type": "integer", "minimum": 0 },
      "no_conozco": { "type": "integer", "minimum": 0 },
      "Totalmente satisfecho": { "type": "integer", "minimum": 0 },
      "Muy satisfecho": { "type": "integer", "minimum": 0 },
      "Satisfecho": { "type": "integer", "minimum": 0 },
      "Insatisfecho": { "type": "integer", "minimum": 0 },
      "Totalmente insatisfecho": { "type": "integer", "minimum": 0 },
      "No utilizo": { "type": "integer", "minimum": 0 },
      "No conozco": { "type": "integer", "minimum": 0 }
    }
  }
}
