{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "respuestas.schema.json",
  "title": "respuestas.json",
  "description": "Tabla de respuestas por periodo: una fila por respuesta, con numeros que apuntan a las opciones de cada pregunta. Alimenta al asistente del item 1.9. Desde version 1.1 el archivo declara cada columna publicada en el bloque 'preguntas'.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nivel",
    "periodo",
    "respuestas",
    "cabeceras",
    "opciones",
    "filas"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "nivel": {
      "type": "string"
    },
    "periodo": {
      "type": "string"
    },
    "respuestas": {
      "type": "integer",
      "minimum": 0
    },
    "cabeceras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preguntas": {
      "description": "Declaracion de cada columna publicada: id estable, nombre publicado, tipo de columna, texto de la pregunta y escala (solo para las medidas).",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nombre",
          "tipo",
          "pregunta"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "nombre": {
            "type": "string",
            "minLength": 1
          },
          "tipo": {
            "type": "string",
            "enum": [
              "medida",
              "agrupacion",
              "fecha",
              "identificador"
            ]
          },
          "pregunta": {
            "type": "string",
            "minLength": 1
          },
          "escala": {
            "type": "string"
          }
        },
        "if": {
          "properties": {
            "tipo": {
              "const": "medida"
            }
          },
          "required": [
            "tipo"
          ]
        },
        "then": {
          "required": [
            "escala"
          ],
          "properties": {
            "escala": {
              "minLength": 1
            }
          }
        }
      }
    },
    "opciones": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "filas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fechas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluidas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pregunta",
          "motivo"
        ],
        "properties": {
          "pregunta": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.1"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "required": [
          "preguntas"
        ]
      }
    }
  ]
}
