{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "respuestas.schema.json",
  "title": "respuestas.json",
  "description": "Tabla de respuestas por periodo: una fila por respuesta, con numeros que apuntan a las opciones de cada pregunta. Alimenta al asistente del item 1.9.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "nivel",
    "periodo",
    "respuestas",
    "cabeceras",
    "opciones",
    "filas"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "nivel": {
      "type": "string"
    },
    "periodo": {
      "type": "string"
    },
    "respuestas": {
      "type": "integer",
      "minimum": 0
    },
    "cabeceras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "opciones": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string"
        }
      }
    },
    "filas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "fechas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluidas": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pregunta",
          "motivo"
        ],
        "properties": {
          "pregunta": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    }
  }
}
