# Copia este archivo a .env y completa los valores reales.
# Nunca commitees .env en Git.

# DeepSeek API key (obligatoria para el análisis cualitativo con IA)
# DEEPSEEK_API_KEY=

# Configuración opcional del motor cualitativo (valores documentados por defecto)
IA_CUALITATIVO_WORKERS=15
IA_CUALITATIVO_MAX_RPM=60
IA_CUALITATIVO_TIMEOUT=60

# Umbral fail-closed del motor IA: si mas de este porcentaje de comentarios falla
# por API (DeepSeek y NVIDIA), el ETL aborta y NO publica sentimiento.json.
# 0 = estricto (cualquier fallo aborta) · 100 = desactivado.
IA_CUALITATIVO_MAX_FALLOS_API_PCT=20

# Motor de respaldo NVIDIA (opcional; se usa si DeepSeek falla o no está configurado)
# NVIDIA_API_KEY=
# IA_CUALITATIVO_FALLBACK_MODEL=nemotron-3-ultra-550b-a55b
